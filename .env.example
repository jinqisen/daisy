# =============================================================================
# Daisy 环境变量配置模板
# 复制此文件为 .env 并填入你的配置
#   cp .env.example .env
# =============================================================================

# ---- 运行模式 ----
# 桌面版(嵌入模式)自动设为 1,无需手动设置
# EMBEDDED_MODE=1

# ---- 服务端口 ----
# HOST=127.0.0.1
# PORT=30021

# ---- LLM 大模型配置 ----
# 必填:至少配置一个提供商的 API Key
# 华为云 ModelArts (推荐)
# MAAS_API_KEY=your_maas_api_key_here
# 硅基流动 SiliconFlow
# SILICONFLOW_API_KEY=your_siliconflow_api_key_here
# OpenAI
# OPENAI_API_KEY=your_openai_api_key_here

# 默认使用的 LLM 提供商 (huaweicloud / siliconflow / openai)
# DEFAULT_LLM_PROVIDER=huaweicloud
# DEFAULT_LLM_MODEL_NAME=deepseek-v3.2

# 嵌入模型 (用于长期记忆/向量检索)
# EMBEDDING_PROVIDER=siliconflow
# EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5

# ---- 安全 ----
# JWT 签名密钥。桌面版首次启动自动生成随机密钥;
# server 部署请务必设置固定值,否则重启后所有 token 失效。
# SECRET_KEY=your_random_secret_here

# ---- 数据库 ----
# 桌面版使用 SQLite (自动);server 部署可配置 PostgreSQL
# DATABASE_URL=sqlite:///./daisy.db

# ---- Redis ----
# 桌面版使用进程内缓存(自动);server 部署需配置
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ---- 向量数据库 (Qdrant) ----
# 桌面版使用本地嵌入模式(自动)
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# ---- 可选功能 ----
# 联网搜索 (华为云搜索服务)
# HUAWEI_SEARCH_API_KEY=your_search_api_key_here
