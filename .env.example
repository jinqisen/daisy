# =============================================================================
# Daisy 环境变量配置模板
# 复制此文件为 .env 并填入你的配置
#   cp .env.example .env
# =============================================================================

# ---- 运行模式 ----
# 桌面版（嵌入模式）自动设为 1，无需手动设置
# EMBEDDED_MODE=1

# ---- 服务端口 ----
# HOST=127.0.0.1
# PORT=30021

# ---- LLM 大模型配置（OpenAI 兼容接口）----
# Daisy 兼容所有提供 OpenAI 兼容 API 的服务商。
# 只需配置以下三项：

# API 密钥（必填）
# OPENAI_API_KEY=sk-your-api-key-here

# 接口地址（可选，默认 OpenAI）
# OPENAI_BASE_URL=https://api.openai.com/v1

# 模型名称（可选，默认 gpt-4o）
# LLM_MODEL_NAME=gpt-4o

# 常用服务商示例：
# OpenAI:        OPENAI_BASE_URL=https://api.openai.com/v1          LLM_MODEL_NAME=gpt-4o
# DeepSeek:      OPENAI_BASE_URL=https://api.deepseek.com/v1        LLM_MODEL_NAME=deepseek-chat
# 硅基流动:       OPENAI_BASE_URL=https://api.siliconflow.cn/v1      LLM_MODEL_NAME=Pro/deepseek-ai/DeepSeek-V3.2
# 通义千问:       OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL_NAME=qwen-plus
# 智谱 GLM:      OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL_NAME=glm-4-flash
# Moonshot:      OPENAI_BASE_URL=https://api.moonshot.cn/v1         LLM_MODEL_NAME=moonshot-v1-8k

# 嵌入模型（用于长期记忆/向量检索）
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_MODEL_NAME=text-embedding-3-small
# EMBEDDING_DIMS=1536

# ---- 安全 ----
# JWT 签名密钥。桌面版首次启动自动生成随机密钥；
# server 部署请务必设置固定值，否则重启后所有 token 失效。
# SECRET_KEY=your_random_secret_here

# ---- 数据库 ----
# 桌面版使用 SQLite（自动）；server 部署可配置 PostgreSQL
# DATABASE_URL=sqlite:///./daisy.db

# ---- Redis ----
# 桌面版使用进程内缓存（自动）；server 部署需配置
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ---- 向量数据库（Qdrant）----
# 桌面版使用本地嵌入模式（自动）
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# ---- 可选功能 ----
# 联网搜索（华为云搜索服务）
# HUAWEI_SEARCH_API_KEY=your_search_api_key_here
